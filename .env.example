# SMTP credentials for contact form
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Production keys from https://developer.ebay.com/my/keys
# App ID is the client id, Cert ID is the client secret.
# The shop snapshot is built by `npm run sync-shop` (also runs before `npm run build`).
# EBAY_REFRESH_TOKEN is the seller consent used to list every active offer. It lasts about 18 months.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
# eBay member name whose current offers are listed.
EBAY_SELLER_USERNAME=
# production (default) or sandbox
EBAY_ENVIRONMENT=production
# Optional. Sent as the eBay search keyword when the shop search box is empty.
EBAY_SEARCH_QUERY=
# Nightly production rebuild. Create a Deploy Hook in Vercel and set both values there.
VERCEL_DEPLOY_HOOK=
CRON_SECRET=
